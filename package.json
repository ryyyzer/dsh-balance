{
  "name": "dsh-balance",
  "version": "0.1.1",
  "description": "Balance chip + today's per-model usage popup + 余额配置 settings (platform userToken & auto-refresh interval) for DeepSeek Harness (dsh web / desktop).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "deepseek-harness",
    "balance",
    "usage",
    "plugin"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ],
      "platform": "web"
    }
  }
}
